<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.asimov.sparrow.mapper.UserMapper">

  <select id="selectByEmail" resultType="top.asimov.sparrow.model.entity.User">
    SELECT id,
           email,
           display_name,
           password_hash,
           status,
           created_at,
           updated_at
    FROM app_user
    WHERE LOWER(email) = LOWER(#{email})
    LIMIT 1
  </select>
</mapper>
